{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "agent": {
    "spec-verifier": {
      "model": "opencode/mimo-v2-free",
      "mode": "subagent",
      "description": "Verifica criterios de aceptación de specs contra código y mockups visuales"
    }
  }
}
